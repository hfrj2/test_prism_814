<UserControl
    x:Class="test_prism_814.Views.NoteManageUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*" />
            <ColumnDefinition Width="4.5*" />
        </Grid.ColumnDefinitions>

        <!--  ============ 左侧：便签列表 + 搜索框 ============  -->
        <Border
            Grid.Column="0"
            Padding="10"
            Background="#8BAE66"
            CornerRadius="8">
            <Grid>
                <!--  用 Grid 替代 StackPanel  -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!--  标题  -->
                    <RowDefinition Height="Auto" />
                    <!--  搜索框  -->
                    <RowDefinition Height="*" />
                    <!--  列表（填充剩余空间）  -->
                </Grid.RowDefinitions>

                <!--  标题  -->
                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,10"
                    FontSize="18"
                    FontWeight="Bold"
                    Text="📋 我的便签" />

                <!--  搜索框  -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        Padding="8,5"
                        Background="White"
                        BorderBrush="#CCC"
                        BorderThickness="1"
                        FontSize="14"
                        Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        Width="40"
                        Height="30"
                        Margin="5,0,0,0"
                        Background="#3498DB"
                        BorderThickness="0"
                        Command="{Binding SearchCommand}"
                        Cursor="Hand"
                        FontWeight="Bold"
                        Foreground="White">
                        <TextBlock FontSize="16" Text="🔍" />
                    </Button>
                </Grid>

                <!--  便签列表：自动填充剩余高度，滚动条自动出现  -->
                <ListBox
                    Grid.Row="2"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Notes}"
                    SelectedItem="{Binding SelectedNote, Mode=TwoWay}">

                    <!--  ✅ 让每个 Item 填满宽度  -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Style.Triggers>
                                <!--  可选：悬停和选中效果  -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F8FF" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E0F0FF" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!--  ✅ Border 宽度填满父容器  -->
                            <Border
                                Margin="0,5"
                                Padding="10"
                                HorizontalAlignment="Stretch"
                                Background="White"
                                CornerRadius="6">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="{Binding Title}" />
                                    <TextBlock
                                        MaxWidth="400"
                                        MaxHeight="40"
                                        FontSize="12"
                                        Foreground="#666"
                                        Text="{Binding Content}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#999"
                                        Text="{Binding UpdatedAt, StringFormat='yyyy-MM-dd HH:mm'}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!--  ============ 右侧：编辑区域（完全不变） ============  -->
        <Border
            Grid.Column="1"
            Margin="20,0,0,0"
            Padding="10"
            Background="#8BAE66"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,15"
                    FontSize="18"
                    FontWeight="Bold"
                    Text="✏️ 编辑便签" />

                <StackPanel Grid.Row="1">
                    <TextBlock
                        Margin="0,5"
                        FontWeight="SemiBold"
                        Text="标题" />
                    <TextBox
                        Height="40"
                        Padding="8"
                        FontSize="16"
                        Text="{Binding Title}" />
                    <TextBlock
                        Margin="0,10,0,5"
                        FontWeight="SemiBold"
                        Text="内容" />
                </StackPanel>
                <Grid Grid.Row="2">

                    <TextBox
                        Padding="8"
                        AcceptsReturn="True"
                        FontSize="14"
                        Text="{Binding Content}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </Grid>

                <StackPanel
                    Grid.Row="4"
                    Margin="0,15,0,0"
                    Orientation="Horizontal">
                    <Button
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        Background="#4CAF50"
                        BorderThickness="0"
                        Command="{Binding SaveCommand}"
                        Content="💾 保存"
                        Cursor="Hand"
                        FontWeight="Bold"
                        Foreground="White"
                        Style="{StaticResource RoundedTransparentButtonStyle}" />

                    <Button
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        Background="#E74C3C"
                        BorderThickness="0"
                        Command="{Binding DeleteCommand}"
                        Content="🗑️ 删除"
                        Cursor="Hand"
                        FontWeight="Bold"
                        Foreground="White"
                        Style="{StaticResource RoundedTransparentButtonStyle}" />

                    <Button
                        Width="100"
                        Height="40"
                        Background="#3498DB"
                        BorderThickness="0"
                        Command="{Binding NewCommand}"
                        Content="➕ 新建"
                        Cursor="Hand"
                        FontWeight="Bold"
                        Foreground="White"
                        Style="{StaticResource RoundedTransparentButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>