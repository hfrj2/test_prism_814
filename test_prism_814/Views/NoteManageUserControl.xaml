<UserControl x:Class="test_prism_814.Views.NoteManageUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="White">

    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧：便签列表 + 搜索框 ============ -->
        <Border Grid.Column="0" Background="#F5F5F5" CornerRadius="8" Padding="10">
            <Grid>
                <!-- 用 Grid 替代 StackPanel -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- 标题 -->
                    <RowDefinition Height="Auto" />
                    <!-- 搜索框 -->
                    <RowDefinition Height="*" />
                    <!-- 列表（填充剩余空间） -->
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Row="0" Text="📋 我的便签" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                <!-- 搜索框 -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                     Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="14" 
                     Padding="8,5"
                     Background="White"
                     BorderBrush="#CCC"
                     BorderThickness="1"/>
                    <Button Grid.Column="1" 
                    Command="{Binding SearchCommand}"
                    Width="40" Height="30" Margin="5,0,0,0"
                    Background="#3498DB" Foreground="White" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand">
                        <TextBlock Text="🔍" FontSize="16"/>
                    </Button>
                </Grid>

                <!-- 便签列表：自动填充剩余高度，滚动条自动出现 -->
                <ListBox Grid.Row="2" 
                 ItemsSource="{Binding Notes}" 
                 SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                 Background="Transparent"
                     
                 BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="6" Padding="10" Margin="0,5">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding Content}" 
                                       TextWrapping="Wrap" 
                                       Foreground="#666" 
                                       FontSize="12"
                                       MaxHeight="40"
                                       TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding UpdatedAt, StringFormat='yyyy-MM-dd HH:mm'}" 
                                       FontSize="11" Foreground="#999"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ============ 右侧：编辑区域（完全不变） ============ -->
        <Grid Grid.Column="1" Margin="20,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="✏️ 编辑便签" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

            <StackPanel Grid.Row="1">
            <TextBlock Text="标题" FontWeight="SemiBold" Margin="0,5"/>
            <TextBox Text="{Binding Title}" FontSize="16" Padding="8" Height="40"/>
                <TextBlock Text="内容" FontWeight="SemiBold" Margin="0,10,0,5"/>
            </StackPanel>
            <Grid Grid.Row="2">
              
            <TextBox Text="{Binding Content}" 
                     FontSize="14" Padding="8" 
                     AcceptsReturn="True" 
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>
            </Grid>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,15,0,0">
                <Button Content="💾 保存" 
                        Command="{Binding SaveCommand}"
                        Width="100" Height="40" Margin="0,0,10,0"
                        Background="#4CAF50" FontWeight="Bold"
                        Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                     
                        Style="{StaticResource RoundedTransparentButtonStyle}"/>

                <Button Content="🗑️ 删除" 
                        Command="{Binding DeleteCommand}"
                        Width="100" Height="40" Margin="0,0,10,0"
                        Background="#E74C3C" Foreground="White" FontWeight="Bold"
                         Style="{StaticResource RoundedTransparentButtonStyle}"
                        BorderThickness="0" Cursor="Hand"/>

                <Button Content="➕ 新建" 
                        Command="{Binding NewCommand}"
                        Width="100" Height="40"
                        Background="#3498DB" Foreground="White" FontWeight="Bold"
                         Style="{StaticResource RoundedTransparentButtonStyle}"
                        BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>