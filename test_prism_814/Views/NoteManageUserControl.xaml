<UserControl x:Class="test_prism_814.Views.NoteManageUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="White">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧：便签列表 + 搜索框 ============ -->
        <Border Grid.Column="0" Background="#F5F5F5" CornerRadius="8" Padding="10">
            <StackPanel>
                <TextBlock Text="📋 我的便签" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                <!-- 🆕 搜索框 -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 搜索输入框 -->
                    <TextBox Grid.Column="0" 
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" 
                             Padding="8,5"
                             Background="White"
                             BorderBrush="#CCC"
                             BorderThickness="1"
                            >
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="ToolTip" Value="输入关键词搜索"/>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- 搜索按钮 -->
                    <Button Grid.Column="1" 
                            Command="{Binding SearchCommand}"
                            Width="40" Height="30" Margin="5,0,0,0"
                            Background="#3498DB" Foreground="White" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand"
                           >
                        <TextBlock Text="🔍" FontSize="16"/>
                    </Button>
                </Grid>

                <!-- 便签列表 -->
                <ListBox ItemsSource="{Binding Notes}" 
                         SelectedItem="{Binding SelectedNote,Mode=TwoWay}"
                         Height="370" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="6" Padding="10" Margin="0,5">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding Content}" 
                                               TextWrapping="Wrap" 
                                               Foreground="#666" 
                                               FontSize="12"
                                               MaxHeight="40"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding UpdatedAt, StringFormat='yyyy-MM-dd HH:mm'}" 
                                               FontSize="11" Foreground="#999"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- ============ 右侧：编辑区域（完全不变） ============ -->
        <StackPanel Grid.Column="1" Margin="20,0,0,0">
            <TextBlock Text="✏️ 编辑便签" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

            <TextBlock Text="标题" FontWeight="SemiBold" Margin="0,5"/>
            <TextBox Text="{Binding Title}" FontSize="16" Padding="8" Height="40"/>

            <TextBlock Text="内容" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <TextBox Text="{Binding Content}" 
                     FontSize="14" Padding="8" 
                     AcceptsReturn="True" 
                     TextWrapping="Wrap"
                     Height="250"
                     VerticalScrollBarVisibility="Auto"/>

            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                <Button Content="💾 保存" 
                        Command="{Binding SaveCommand}"
                        Width="100" Height="40" Margin="0,0,10,0"
                        Background="#4CAF50" Foreground="White" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand"/>

                <Button Content="🗑️ 删除" 
                        Command="{Binding DeleteCommand}"
                        Width="100" Height="40" Margin="0,0,10,0"
                        Background="#E74C3C" Foreground="White" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand"/>

                <Button Content="➕ 新建" 
                        Command="{Binding NewCommand}"
                        Width="100" Height="40"
                        Background="#3498DB" Foreground="White" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>