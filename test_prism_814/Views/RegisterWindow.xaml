<Window x:Class="test_prism_814.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="用户注册" Height="600" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#F8F9FA">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">

            <TextBlock Text="📝 用户注册" 
                       FontSize="28" FontWeight="Bold" 
                       HorizontalAlignment="Center"
                       Foreground="#2C3E50"
                       Margin="0,0,0,25"/>

            <TextBlock Text="账号" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Account}" 
                     FontSize="16" Padding="10"
                     Margin="0,0,0,12"
                     BorderBrush="#CCC" BorderThickness="1"/>

            <TextBlock Text="密码（不少于6位）" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox"
                         FontSize="16" Padding="10"
                         Margin="0,0,0,12"
                         BorderBrush="#CCC" BorderThickness="1"
                         PasswordChanged="PasswordBox_PasswordChanged"/>

            <TextBlock Text="确认密码" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="ConfirmPasswordBox"
                         FontSize="16" Padding="10"
                         Margin="0,0,0,12"
                         BorderBrush="#CCC" BorderThickness="1"
                         PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>

            <TextBlock Text="电话" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Phone}" 
                     FontSize="16" Padding="10"
                     Margin="0,0,0,12"
                     BorderBrush="#CCC" BorderThickness="1"/>

            <TextBlock Text="地址" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Address}" 
                     FontSize="16" Padding="10"
                     Margin="0,0,0,12"
                     BorderBrush="#CCC" BorderThickness="1"/>

            <TextBlock Text="{Binding ErrorMessage}" 
                       Foreground="Red" 
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <Button Content="注 册" 
                    Command="{Binding RegisterCommand}"
                    Height="45" FontSize="16" FontWeight="Bold"
                    Background="#27AE60" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Margin="0,0,0,12"/>

            <TextBlock Text="已有账号？去登录 →" 
                       Foreground="#3498DB" 
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Cursor="Hand"
                       MouseLeftButtonDown="GoToLogin_MouseLeftButtonDown"/>
        </StackPanel>
    </Grid>
</Window>