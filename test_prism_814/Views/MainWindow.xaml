
<Window
    x:Class="test_prism_814.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:test_prism_814.Models"
    xmlns:prism="http://prismlibrary.com/"
    Title="Prism 数据绑定导航测试"
    Width="850"
    Height="500"
    prism:ViewModelLocator.AutoWireViewModel="False"
    WindowStartupLocation="CenterScreen">

    <!--  窗口资源：定义菜单项的显示模板  -->
    <Window.Resources>
        <!--  菜单项模板  -->
        <DataTemplate DataType="{x:Type models:MenuItemModel}">
            <Button
                Height="65"
                Margin="8,4,8,4"
                HorizontalContentAlignment="Center"
                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding ViewName}"
                Cursor="Hand">

                <!--  按钮内容：图标 + 文字  -->
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="18"
                        Text="{Binding Icon}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#333333"
                        Text="{Binding Header}" />
                </StackPanel>

                <!--  ✅ 正确的圆角按钮样式：通过 ControlTemplate 实现  -->
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="#CCCCCC" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <!--  ⭐ Border 才有 CornerRadius  -->
                                    <Border
                                        x:Name="Border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="5"
                                        SnapsToDevicePixels="True">
                                        <!--  ContentPresenter 显示按钮内容  -->
                                        <ContentPresenter
                                            Margin="{TemplateBinding Padding}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#E8E8E8" />
                                            <Setter TargetName="Border" Property="BorderBrush" Value="#999999" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#D0D0D0" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Border" Property="Background" Value="#EEEEEE" />
                                            <Setter Property="Foreground" Value="#999999" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <!--  主布局：左侧菜单栏（宽度 200） + 右侧内容区域  -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="8*" />
        </Grid.ColumnDefinitions>

        <!--  左侧菜单栏：使用 ItemsControl 绑定 MenuItems 集合  -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="10"
                Padding="5"
                HorizontalAlignment="Center"
                FontFamily="FangSong"
                FontSize="24"
                FontWeight="Bold"
                Foreground="ForestGreen"
                Text="菜单" />

            <ItemsControl
                Grid.Row="1"
                Background="#F5F5F5"
                ItemsSource="{Binding MenuItems}" />


        </Grid>
        <!--  右侧内容区域：这就是 Prism 的“插座”（Region）  -->
        <ContentControl
            x:Name="A"
            Grid.Column="1"
            Margin="15,10,15,10"
            prism:RegionManager.RegionName="ContentRegion" />
    </Grid>
</Window>