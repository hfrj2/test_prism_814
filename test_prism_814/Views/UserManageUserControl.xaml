<UserControl x:Class="test_prism_814.Views.UserManageUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="White">

    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：用户列表 -->
        <Border Grid.Column="0" Background="#8BAE66" CornerRadius="8" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="👥 用户管理" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                <!-- 搜索框 -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Padding="8,5"
                             Background="White" BorderBrush="#CCC" BorderThickness="1"/>
                    <Button Grid.Column="1" 
                            Command="{Binding SearchCommand}"
                            Width="40" Height="30" Margin="5,0,0,0"
                            Background="#3498DB" Foreground="White" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand">
                        <TextBlock Text="🔍" FontSize="16"/>
                    </Button>
                </Grid>

                <!-- 用户列表 -->
                <ListBox Grid.Row="2" 
         ItemsSource="{Binding Users}" 
         SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
         Background="Transparent" 
         BorderThickness="0">

                    <!-- ✅ 让每个 Item 填满宽度 -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- ✅ Border 宽度填满父容器 -->
                            <Border Background="White" 
                    CornerRadius="6" 
                    Padding="10" 
                    Margin="0,5"
                    HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock Text="{Binding Account}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding Phone}" Foreground="#666" FontSize="12" MaxWidth="320"/>
                                    <TextBlock Text="{Binding Address}" Foreground="#999" FontSize="12" 
                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 右侧：编辑区域 -->
        <Border Background="#8BAE66" Grid.Column="1" Margin="20,0,0,0" Padding="10" CornerRadius="8">
        <Grid >
                <StackPanel>
            <TextBlock Text="✏️ 编辑用户" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                    <TextBlock Text="账号" FontWeight="SemiBold" Margin="0,5" FontSize="14"/>
            <TextBox Text="{Binding Account}" FontSize="16" Padding="8" Height="40"/>

                    <TextBlock Text="密码" FontWeight="SemiBold" Margin="0,10,0,5" FontSize="14"/>
            <TextBox Text="{Binding Password}" FontSize="16" Padding="8" Height="40"/>

                    <TextBlock Text="电话" FontWeight="SemiBold" Margin="0,10,0,5" FontSize="14"/>
            <TextBox Text="{Binding Phone}" FontSize="16" Padding="8" Height="40"/>

                    <TextBlock Text="地址" FontWeight="SemiBold" Margin="0,10,0,5" FontSize="14"/>
            <TextBox Text="{Binding Address}" FontSize="16" Padding="8" Height="40"/>
                </StackPanel>
            
            
            
                <StackPanel Orientation="Horizontal"  VerticalAlignment="Bottom">
                <Button Content="💾 保存" 
                        Command="{Binding SaveCommand}"
                        Width="100" Height="40" Margin="0,0,10,0"
                        Background="#4CAF50" Foreground="White" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand"
                        Style="{StaticResource RoundedTransparentButtonStyle}"/>

                <Button Content="🗑️ 删除" 
                        Command="{Binding DeleteCommand}"
                        Width="100" Height="40" Margin="0,0,10,0"
                        Background="#E74C3C" Foreground="White" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand"
                        Style="{StaticResource RoundedTransparentButtonStyle}"/>

                <Button Content="➕ 新建" 
                        Command="{Binding NewCommand}"
                        Width="100" Height="40"
                        Background="#3498DB" Foreground="White" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand"
                        Style="{StaticResource RoundedTransparentButtonStyle}"/>
            </StackPanel>
               
            </Grid>
        </Border>
    </Grid>
</UserControl>